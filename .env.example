# Скопируйте этот файл в .env и укажите токен бота MAX:
#   cp .env.example .env
# Токен: https://business.max.ru → Чат-боты → Расширенные настройки
MAX_BOT_TOKEN=

# --- Webhook (production-режим) ---
# Хост и порт, на котором слушает webhook-сервер
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
# Публичный URL, на который MAX доставляет события (внешний адрес/домен)
WEBHOOK_PUBLIC_URL=https://m-bot.consult-b2b.ru/webhook